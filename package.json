    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
